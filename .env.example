# Telegram bot token from @BotFather. Keep private.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Only this account can use the bot.
TELEGRAM_USER_ID=

# Google OAuth desktop client JSON, as one line. Do not commit it.
GOOGLE_CLIENT_CONFIG_JSON=
# Generate a Fernet key once and keep it private; encrypts the Google token in SQLite.
TOKEN_ENCRYPTION_KEY=
# Optional encrypted OAuth token bootstrap for a fresh hosting instance.
GOOGLE_TOKEN_ENCRYPTED=

DATABASE_PATH=data/assistant.sqlite3
TIMEZONE=Asia/Kolkata
CALENDAR_ID=primary
CALENDAR_SYNC_MINUTES=5
CALENDAR_LOOKAHEAD_DAYS=45
REMINDER_CHECK_SECONDS=30

# Optional Render webhook mode. Leave empty for local Telegram polling.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Strands Agents and Strands Decider use the provided hosted API key. No Bedrock/AWS credentials are used.
DECIDER_API_KEY=
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
STRANDS_API_KEY=
STRANDS_BASE_URL=https://da25tnxy06gjk.cloudfront.net/v1
STRANDS_MODEL=qwen3.5-4b

# Optional: Gemini is used only to transcribe Telegram voice notes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GMAIL_SCAN_MINUTES=30
GMAIL_SCAN_MAX_RESULTS=30
VOICE_MAX_MB=20
VOICE_MAX_SECONDS=300

# Optional Notion integration. Share a database with your integration and use its data source ID.
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=
